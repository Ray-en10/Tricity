# Copier ce fichier en ".env" (jamais commité) et renseigner les vraies valeurs.
# Ne jamais remettre les anciennes valeurs compromises - voir SECURITY_NOTES.md

PORT=5008
NODE_ENV=development

# Chaîne de connexion MongoDB Atlas - générer un NOUVEL utilisateur/mot de passe
# après rotation (voir SECURITY_NOTES.md). Ne jamais coller la vraie valeur ici.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/watt

# Secret JWT - générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<generer_une_valeur_forte_et_unique>

# ADMIN_SECRET_KEY a été retiré : il permettait à n'importe qui d'appeler
# POST /api/auth/register avec role=admin pour se créer un compte admin.
# La création d'un admin passe désormais uniquement par POST /api/auth/create-admin,
# qui exige d'être déjà connecté en tant qu'admin (voir SECURITY_NOTES.md).

# --- Notifications (§8 du cahier des charges) ---
# Canal in-app : toujours actif. Canal e-mail : actif si SMTP_HOST est renseigné.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Tricity <no-reply@votre-domaine.tn>

# Canal SMS : présent dans l'application (préférence utilisateur) mais
# NATIVEMENT DÉSACTIVÉ pour éviter des frais d'envoi. Aucun SMS n'est émis
# tant que SMS_ENABLED n'est pas "true" ET qu'un fournisseur n'est pas
# implémenté dans utils/notificationService.js (sendSms).
SMS_ENABLED=false

# Évaluation périodique des seuils (sinon évaluée à chaque consultation du dashboard)
NOTIFICATION_SCHEDULER=false
NOTIFICATION_INTERVAL_MIN=30

# --- Seed de développement (optionnel, JAMAIS en production) ---
# Par défaut aucun compte n'est créé automatiquement au démarrage.
# Pour activer un seed de dev, passer SEED_DEFAULT_DATA=true et fournir
# des mots de passe explicites (pas de valeur par défaut codée en dur) :
SEED_DEFAULT_DATA=false
SEED_ADMIN_EMAIL=admin@watt.tn
SEED_ADMIN_PASSWORD=<choisir_un_mot_de_passe_fort>
SEED_CLIENT_EMAIL=amine@gmail.com
SEED_CLIENT_PASSWORD=<choisir_un_mot_de_passe_fort>
